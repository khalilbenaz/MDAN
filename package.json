{
  "name": "mdan-method",
  "version": "4.0.1",
  "description": "MDAN — AI-driven development methodology: agents, step-by-step wizards, multi-agent debate and a context graph, as IDE commands and an MCP server",
  "type": "module",
  "license": "MIT",
  "author": "Khalil Benaz <khalilbenaz@gmail.com> (https://github.com/khalilbenaz)",
  "repository": {
    "type": "git",
    "url": "https://github.com/khalilbenaz/MDAN.git"
  },
  "homepage": "https://github.com/khalilbenaz/MDAN#readme",
  "bugs": {
    "url": "https://github.com/khalilbenaz/MDAN/issues"
  },
  "keywords": [
    "mdan",
    "ai",
    "agents",
    "mcp",
    "claude",
    "development",
    "methodology",
    "mcp-server",
    "model-context-protocol",
    "agents",
    "wizards"
  ],
  "bin": {
    "mdan-method": "tools/cli/index.js",
    "mdan": "tools/cli/index.js",
    "mdan-mcp": "tools/mcp/bin.js"
  },
  "files": [
    "_mdan/**",
    "!_mdan/state/context-graph.json",
    "!_mdan/state/MDAN-STATE.json",
    "!_mdan/_config/manifest.yaml",
    "!_mdan/_config/files-manifest.csv",
    "!**/*.mdan-new",
    "tools/**",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "!tools/eval/**"
  ],
  "scripts": {
    "build": "node tools/build/build.js",
    "build:check": "node tools/build/build.js --check",
    "validate": "node tools/build/validate.js",
    "lint": "eslint .",
    "test": "node --test",
    "check": "npm run lint && npm run build:check && npm run validate && npm test",
    "serve": "node tools/cli/index.js serve",
    "prepublishOnly": "npm run check",
    "eval": "node tools/eval/run.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
